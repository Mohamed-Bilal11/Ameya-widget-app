<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCard"
    android:layout_width="180dp"
    android:layout_height="180dp"
    android:layout_gravity="center"
    android:background="#E9F1E0"
    android:padding="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top-right logo -->
        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ameyalogo"
            android:contentDescription="Logo" />

        <!-- Icon below logo, aligned to start -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/widget_logo"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:src="@drawable/addfood"
            android:contentDescription="Icon" />

        <!-- Centered data text below icon -->
        <TextView
            android:id="@+id/widget_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_icon"
            android:layout_alignParentStart="true"
            android:layout_marginTop="6dp"
            android:text="No Data"
            android:textColor="#000000"
            android:textSize="15sp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            />
    </RelativeLayout>
</FrameLayout>
